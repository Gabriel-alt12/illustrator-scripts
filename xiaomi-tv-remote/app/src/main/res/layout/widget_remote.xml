<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x1: los cuatro botones mas usados. Sin indicador de conexion a
     proposito: un widget no puede sondear la TV sin gastar bateria. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_button_1"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_accent"
        android:src="@drawable/ic_power"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/quick_power" />

    <ImageView
        android:id="@+id/widget_button_2"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button"
        android:src="@drawable/ic_volume_down"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/quick_volume_down" />

    <ImageView
        android:id="@+id/widget_button_3"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button"
        android:src="@drawable/ic_volume_up"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/quick_volume_up" />

    <ImageView
        android:id="@+id/widget_button_4"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:src="@drawable/ic_volume_mute"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/quick_mute" />
</LinearLayout>
