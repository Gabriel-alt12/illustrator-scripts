<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Socket TCP directo contra adbd en la red local. Nada mas: sin internet real,
         sin cuentas, sin analitica. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Solo para el mando persistente de la barra de notificaciones (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para que el mando de invitados siga escuchando con la pantalla apagada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".TvMandoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvMando"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TvMando">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ejecuta los comandos del widget, los tiles y la notificacion. No se
             exporta: solo lo disparan PendingIntents creados por la propia app. -->
        <receiver
            android:name=".system.TvCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gabriel.tvmando.action.RUN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".system.RemoteWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>

        <!-- Mantiene vivo el servidor del mando de invitados. Ningun tipo con nombre
             de Android describe esto, de ahi specialUse con su explicacion. -->
        <service
            android:name=".system.GuestRemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sirve un mando web en la red local de casa mientras hay visita" />
        </service>

        <service
            android:name=".system.PowerTileService"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="@string/tile_power"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".system.MuteTileService"
            android:exported="true"
            android:icon="@drawable/ic_volume_mute"
            android:label="@string/tile_mute"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
