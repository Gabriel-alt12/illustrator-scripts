# Copia este fichero a keystore.properties y rellena tus datos.
# keystore.properties esta en .gitignore: nunca subas el almacen ni las claves.
#
# Para crear el almacen (una sola vez):
#
#   keytool -genkey -v -keystore mando-tv.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias mando
#
# Guarda el .jks fuera del repositorio y apunta storeFile a su ruta absoluta.

storeFile=/ruta/absoluta/a/mando-tv.jks
storePassword=tu-password-del-almacen
keyAlias=mando
keyPassword=tu-password-de-la-clave
